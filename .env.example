# ==========================================
# FIX MY CAMPUS - BACKEND ENVIRONMENT CONFIG
# ==========================================

# Server Port (Render / Railway / Cloud hosts set this automatically)
PORT=5000

# Node Environment
NODE_ENV=production

# Database Connection URL:
# ------------------------------------------
# For SQLite (Self-Contained file storage):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Render / Supabase / Neon / Railway):
# DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key (Any long secure random string)
JWT_SECRET="fix-my-campus-super-secure-production-jwt-key-2026"

# Frontend Client URL (For CORS allowlist, e.g. your Vercel frontend URL or *)
CLIENT_URL="*"
